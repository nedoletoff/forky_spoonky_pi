# Пример переменных окружения. Скопируй в .env и при необходимости поправь.
# .env не коммитится в git (см. .gitignore).

# Переопределения настроек из config.yaml (необязательно).
# FORKY_SERVER__PORT=8080
# FORKY_CAMERA__SOURCE=usb        # usb или csi (камера Raspberry Pi)
# FORKY_CAMERA__INDEX=0
# FORKY_CAMERA__DEVICE=/dev/video0
# FORKY_MODEL__WEIGHTS=yolo26n.pt
# FORKY_MODEL__IMGSZ=416
# FORKY_MODEL__DEVICE=cpu
# FORKY_LOGGING__LEVEL=INFO
# FORKY_TRAINING__ENABLED=false

# Секреты (если появятся) держим здесь, а не в config.yaml:
# FORKY_SECRET_KEY=change-me
